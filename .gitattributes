#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Targeted EOL rules only — intentionally NO `* text=auto` so that mod
# sources (.java/.json/etc.) keep their existing on-disk storage and no
# repo-wide renormalization (which would mask the OmniChest byte-parity)
# is ever triggered.

# POSIX shell / Gradle wrapper scripts must use LF (sh rejects CRLF)
/gradlew        text eol=lf
mods/*/gradlew  text eol=lf
*.sh            text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# LICENSE is bundled verbatim into every mod jar (as LICENSE_<modid>), so its
# on-disk line endings end up inside a build artifact. Without a rule here the
# checkout depends on core.autocrlf: a Windows clone with autocrlf=true gets
# CRLF while CI (Linux) gets LF, and the two jars differ. Measured: 7047 bytes
# (LF) vs 7167 bytes (CRLF) => different CRC for the LICENSE_omnichest entry.
# Pin it to LF, which is what the index already stores and what CI produces.
/LICENSE  text eol=lf

# Known binaries — never apply EOL normalization or diff as text
*.png  binary
*.jar  binary
*.ico  binary
