# gradle

.gradle/
build/
out/
classes/

# buildSrc の convention-plugin ソースは「build」という名のパッケージ
# (com.fabricmod.build) に置かれており、 上の広域 `build/` ルール (Gradle の
# 出力ディレクトリ用) に巻き込まれて *ソース* まで無視されてしまう。
# ここで明示的に再追跡対象に戻す (これが無いと buildSrc のソースが Git に載らない)。
!buildSrc/src/main/groovy/com/fabricmod/build/
!buildSrc/src/main/groovy/com/fabricmod/build/**

# 配布用の集約成果物 (collectDist / buildAll が生成)
dist/

# eclipse

*.launch

# idea

.idea/
*.iml
*.ipr
*.iws

# vscode

.settings/
.vscode/
bin/
.classpath
.project

# macos

*.DS_Store

# fabric

run/

# java

hs_err_*.log
replay_*.log
*.hprof
*.jfr

# git tooling diagnostics (machine-specific env dumps — do not track)

gcm-diagnose.log

# Claude Code
#
# settings.local.json は「その開発者のマシン固有」の許可リストで、 絶対パスや
# OS 固有のシェル呼び出しがそのまま入る。 以前これが追跡されており、 特定の
# マシンのユーザー名入りパスと PowerShell 専用エントリがリポジトリに載っていた。
# 共有したい設定は .claude/settings.json (追跡対象) に書くこと。
.claude/settings.local.json
